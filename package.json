{
  "name": "partnership-ten",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "server": "node --watch --env-file-if-exists=.env server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "test": "node --env-file-if-exists=.env --test --test-timeout=90000 server/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1"
  }
}
