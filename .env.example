# Salin menjadi .env (tidak boleh di-commit). Di Vercel isi lewat Project Settings > Environment Variables.

# PostgreSQL. Di Vercel pakai URL "pooled" (Neon/Supabase), mis. postgresql://user:sandi@host/db?sslmode=require
DATABASE_URL=postgresql://postgres:ganti_ini@127.0.0.1:5432/partnership_ten

# Wajib di produksi: string acak panjang (openssl rand -hex 32)
SESSION_SECRET=

# Admin Sistem pertama (dibuat sekali bila belum ada). Sandi wajib diganti saat login pertama.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Tampilkan akun demo satu klik di halaman depan dan isi data fiktif. HANYA untuk lingkungan demo, jangan di produksi.
DEMO_MODE=

# Wajib agar Vercel Cron dapat memanggil /api/cron/* (string acak panjang). Vercel mengirimnya sebagai Bearer token.
CRON_SECRET=

# Opsional: reminder lewat email. Tanpa ini reminder hanya masuk notifikasi dalam aplikasi.
SMTP_URL=
MAIL_FROM=Partnership TEN <no-reply@contoh.id>
APP_URL=https://partnership-ten.contoh.id

# Hanya untuk tes: database KOSONG khusus tes (tes membuat dan menghapus skema sementara). Jangan arahkan ke produksi.
TEST_DATABASE_URL=postgresql://postgres:ganti_ini@127.0.0.1:5432/partnership_ten_uji
